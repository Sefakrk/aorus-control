import { Button, Switch } from "std-widgets.slint";

component ColorChip inherits TouchArea {
    in property <color> chip_color;
    in property <bool> is_selected: false;
    width: 36px;
    height: 36px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: root.chip_color;
        border-width: root.is_selected ? 3px : 1px;
        border-color: root.is_selected ? #ffffff : #333846;
    }
}

component ModeButton inherits TouchArea {
    in property <string> title;
    in property <string> icon;
    in property <bool> is_active: false;
    height: 52px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: root.is_active ? #00ffa3.transparentize(88%) : #1a1d26;
        border-width: root.is_active ? 2px : 1px;
        border-color: root.is_active ? #00ffa3 : #2b3040;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.icon;
                font-size: 15px;
                horizontal-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
                horizontal-alignment: center;
            }
        }
    }
}

component MuxButton inherits TouchArea {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <bool> is_active: false;
    height: 64px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: root.is_active ? #00ffa3.transparentize(88%) : #1a1d26;
        border-width: root.is_active ? 2px : 1px;
        border-color: root.is_active ? #00ffa3 : #2b3040;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.icon;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
                horizontal-alignment: center;
            }
            Text {
                text: root.subtitle;
                font-size: 10px;
                color: root.is_active ? #00ffa3aa : #6b7280;
                horizontal-alignment: center;
            }
        }
    }
}

component NavTab inherits TouchArea {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> is_active: false;
    height: 50px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 9px;
        background: root.is_active ? #141e1a : (parent.has-hover ? #161922 : #00000000);
        border-width: 1px;
        border-color: root.is_active ? #00ffa355 : #00000000;

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
            }
            Text {
                text: root.subtitle;
                font-size: 10px;
                color: root.is_active ? #00ffa3aa : #6b7280;
            }
        }
    }
}

component CustomSlider inherits Rectangle {
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);
    callback released(float);

    height: 26px;
    min-width: 180px;
    horizontal-stretch: 1;

    property <float> ratio: Math.clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0.0, 1.0);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        width: 100%;
        border-radius: 3px;
        background: #232733;

        Rectangle {
            x: 0;
            y: 0;
            height: 100%;
            width: root.ratio * parent.width;
            border-radius: 3px;
            background: #00ffa3;
        }
    }

    Rectangle {
        x: root.ratio * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: #00ffa3;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        moved => {
            if (self.pressed && root.width > 0px) {
                let r = Math.clamp(self.mouse-x / root.width, 0.0, 1.0);
                let v = Math.round(root.minimum + r * (root.maximum - root.minimum));
                if (v != Math.round(root.value)) {
                    root.changed(v);
                }
            }
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && root.width > 0px) {
                let r = Math.clamp(self.mouse-x / root.width, 0.0, 1.0);
                let v = Math.round(root.minimum + r * (root.maximum - root.minimum));
                root.changed(v);
            }
            if (ev.kind == PointerEventKind.up) {
                root.released(Math.round(root.value));
            }
        }
    }
}

