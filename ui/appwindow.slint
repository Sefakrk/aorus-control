                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #38bdf8;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Mevcut: " + root.display_hz + "Hz";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.display_hz == 165 ? #00ffa3 : #f59e0b;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ModeButton {
                                        title: "60Hz (Pil Tasarrufu)";
                                        icon: "🔋";
                                        is_active: root.display_hz == 60;
                                        clicked => {
                                            root.set_display_hz(60);
                                        }
                                    }

                                    ModeButton {
                                        title: "165Hz (Oyun / Akıcı)";
                                        icon: "⚡";
                                        is_active: root.display_hz == 165;
                                        clicked => {
                                            root.set_display_hz(165);
                                        }
                                    }
                                }

                                Text {
                                    text: "ℹ️ Ekran hızı Windows API üzerinden anlık değiştirilir. Yeniden başlatma gerektirmez.";
                                    font-size: 10px;
                                    color: #6b7280;
                                }
                            }
                        }
                    }

                    // TAB 2: AYDINLATMA (KLAVYE + BEACON BİRLEŞİK)
                    if root.active_tab == 2 : VerticalLayout {
                        spacing: 10px;

                        // Üst Kart: Klavye RGB
                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "⌨️  KEYBOARD RGB (SOLID STATIC)";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #00ffa3;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Seçili: " + root.active_kb_color;
                                        font-size: 11px;
                                        color: #6b7280;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ColorChip {
                                        chip_color: #00a2ff;
                                        is_selected: root.active_kb_color == "Blue";
                                        clicked => { root.active_kb_color = "Blue"; root.set_keyboard_color("Blue"); }
                                    }
                                    ColorChip {
                                        chip_color: #ff1a40;
                                        is_selected: root.active_kb_color == "Red";
                                        clicked => { root.active_kb_color = "Red"; root.set_keyboard_color("Red"); }
                                    }
                                    ColorChip {
                                        chip_color: #10b981;
                                        is_selected: root.active_kb_color == "Green";
                                        clicked => { root.active_kb_color = "Green"; root.set_keyboard_color("Green"); }
                                    }
                                    ColorChip {
                                        chip_color: #eab308;
                                        is_selected: root.active_kb_color == "Yellow";
                                        clicked => { root.active_kb_color = "Yellow"; root.set_keyboard_color("Yellow"); }
                                    }
                                    ColorChip {
                                        chip_color: #a855f7;
                                        is_selected: root.active_kb_color == "Purple";
                                        clicked => { root.active_kb_color = "Purple"; root.set_keyboard_color("Purple"); }
                                    }
                                    ColorChip {
                                        chip_color: #f97316;
                                        is_selected: root.active_kb_color == "Orange";
                                        clicked => { root.active_kb_color = "Orange"; root.set_keyboard_color("Orange"); }
                                    }
                                    ColorChip {
                                        chip_color: #f3f4f6;
                                        is_selected: root.active_kb_color == "White";
                                        clicked => { root.active_kb_color = "White"; root.set_keyboard_color("White"); }
                                    }
                                    ColorChip {
                                        chip_color: #111317;
                                        is_selected: root.active_kb_color == "Off";
                                        clicked => { root.active_kb_color = "Off"; root.set_keyboard_color("Off"); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Parlaklık:";
                                        font-size: 12px;
                                        color: #9ca3af;
                                        vertical-alignment: center;
                                        width: 65px;
                                    }
                                    CustomSlider {
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.kb_brightness;
                                        changed(v) => {
                                            root.kb_brightness = v;
                                            root.set_keyboard_brightness(v);
                                        }
                                        released(v) => {
                                            root.save_keyboard_brightness(v);
                                        }
                                    }
                                    Text {
                                        text: "\{Math.round(root.kb_brightness)}%";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                        width: 38px;
                                    }
                                }
                            }
                        }

                        // Alt Kart: Arka Işık (Beacon)
                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "✨  REAR LIGHTBAR (AORUS BEACON)";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #38bdf8;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Güç:"; font-size: 12px; color: #9ca3af; vertical-alignment: center; }
                                        Switch {
                                            checked: root.lightbar_enabled;
                                            toggled => {
                                                root.lightbar_enabled = self.checked;
                                                root.toggle_lightbar(self.checked);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ColorChip {
                                        chip_color: #00a2ff;
                                        is_selected: root.active_bar_color == "Blue";
                                        clicked => { root.active_bar_color = "Blue"; root.set_lightbar_color("Blue"); }
                                    }
                                    ColorChip {
                                        chip_color: #ff1a40;
                                        is_selected: root.active_bar_color == "Red";
                                        clicked => { root.active_bar_color = "Red"; root.set_lightbar_color("Red"); }
                                    }
                                    ColorChip {
                                        chip_color: #10b981;
                                        is_selected: root.active_bar_color == "Green";
                                        clicked => { root.active_bar_color = "Green"; root.set_lightbar_color("Green"); }
                                    }
                                    ColorChip {
                                        chip_color: #eab308;
                                        is_selected: root.active_bar_color == "Yellow";
                                        clicked => { root.active_bar_color = "Yellow"; root.set_lightbar_color("Yellow"); }
                                    }
                                    ColorChip {
                                        chip_color: #a855f7;
                                        is_selected: root.active_bar_color == "Purple";
                                        clicked => { root.active_bar_color = "Purple"; root.set_lightbar_color("Purple"); }
                                    }
                                    ColorChip {
                                        chip_color: #f97316;
                                        is_selected: root.active_bar_color == "Orange";
                                        clicked => { root.active_bar_color = "Orange"; root.set_lightbar_color("Orange"); }
                                    }
                                    ColorChip {
                                        chip_color: #f3f4f6;
                                        is_selected: root.active_bar_color == "White";
                                        clicked => { root.active_bar_color = "White"; root.set_lightbar_color("White"); }
                                    }
                                    ColorChip {
                                        chip_color: #111317;
                                        is_selected: root.active_bar_color == "Off";
                                        clicked => { root.active_bar_color = "Off"; root.set_lightbar_color("Off"); }
                                    }
                                }

                                Text {
                                    text: "ℹ️ Ana bar, egzoz şeridi ve Aorus Beacon projeksiyonu senkronize tek renk olarak sürülür.";
                                    font-size: 11px;
                                    color: #6b7280;
                                }
                            }
                        }
                    }

                    // TAB 3: PİL VE SİSTEM AYARLARI
                    if root.active_tab == 3 : VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "🔋  BATTERY HEALTH CARE";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #7dd3fc;
                                            letter-spacing: 1px;
                                        }
                                        Text {
                                            text: "Prizde kullanırken şarjı %80'de keserek pil ömrünü uzatır.";
                                            font-size: 12px;
                                            color: #6b7280;
                                        }
                                        Text {
                                            text: root.battery_hardware_text;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.battery_limit ? #00ffa3 : #9ca3af;
                                        }
                                    }

                                    Switch {
                                        checked: root.battery_limit;
                                        toggled => {
                                            root.battery_limit = self.checked;
                                            root.toggle_battery_limit(self.checked);
                                        }
                                    }
                                }
                            }
                        }

                        // Kapatma Davranışı (System Tray) Kartı
                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "🗔  KAPATMA DAVRANIŞI (SYSTEM TRAY)";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #f59e0b;
                                            letter-spacing: 1px;
                                        }
                                        Text {
                                            text: root.close_to_tray ? "Pencere kapatıldığında arka planda çalışmaya devam eder (Tray)." : "Pencere kapatıldığında uygulama tamamen kapanır.";
                                            font-size: 12px;
                                            color: #6b7280;
                                        }
                                    }

                                    Switch {
                                        checked: root.close_to_tray;
                                        toggled => {
                                            root.close_to_tray = self.checked;
                                            root.toggle_close_to_tray(self.checked);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
