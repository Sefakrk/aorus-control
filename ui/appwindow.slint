                                        clicked => { root.active_bar_color = "Blue"; root.set_lightbar_color("Blue"); }
                                    }
                                    ColorChip {
                                        chip_color: #ff1a40;
                                        is_selected: root.active_bar_color == "Red";
                                        clicked => { root.active_bar_color = "Red"; root.set_lightbar_color("Red"); }
                                    }
                                    ColorChip {
                                        chip_color: #10b981;
                                        is_selected: root.active_bar_color == "Green";
                                        clicked => { root.active_bar_color = "Green"; root.set_lightbar_color("Green"); }
                                    }
                                    ColorChip {
                                        chip_color: #eab308;
                                        is_selected: root.active_bar_color == "Yellow";
                                        clicked => { root.active_bar_color = "Yellow"; root.set_lightbar_color("Yellow"); }
                                    }
                                    ColorChip {
                                        chip_color: #a855f7;
                                        is_selected: root.active_bar_color == "Purple";
                                        clicked => { root.active_bar_color = "Purple"; root.set_lightbar_color("Purple"); }
                                    }
                                    ColorChip {
                                        chip_color: #f97316;
                                        is_selected: root.active_bar_color == "Orange";
                                        clicked => { root.active_bar_color = "Orange"; root.set_lightbar_color("Orange"); }
                                    }
                                    ColorChip {
                                        chip_color: #f3f4f6;
                                        is_selected: root.active_bar_color == "White";
                                        clicked => { root.active_bar_color = "White"; root.set_lightbar_color("White"); }
                                    }
                                    ColorChip {
                                        chip_color: #111317;
                                        is_selected: root.active_bar_color == "Off";
                                        clicked => { root.active_bar_color = "Off"; root.set_lightbar_color("Off"); }
                                    }
                                }

                                Text {
                                    text: "â„¹ï¸ Ana bar, egzoz ÅŸeridi ve Aorus Beacon projeksiyonu senkronize tek renk olarak sÃ¼rÃ¼lÃ¼r.";
                                    font-size: 11px;
                                    color: #6b7280;
                                }
                            }
                        }
                    }

                    // TAB 4: PÄ°L
                    if root.active_tab == 4 : VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "ðŸ”‹  BATTERY HEALTH CARE";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #7dd3fc;
                                            letter-spacing: 1px;
                                        }
                                        Text {
                                            text: "Prizde kullanÄ±rken ÅŸarjÄ± %80'de keserek pil Ã¶mrÃ¼nÃ¼ uzatÄ±r.";
                                            font-size: 12px;
                                            color: #6b7280;
                                        }
                                    }

                                    Switch {
                                        checked: root.battery_limit;
                                        toggled => {
                                            root.battery_limit = self.checked;
                                            root.toggle_battery_limit(self.checked);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

