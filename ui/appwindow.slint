                                        color: #38bdf8;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "GÃ¼Ã§:"; font-size: 12px; color: #9ca3af; vertical-alignment: center; }
                                        Switch {
                                            checked: root.lightbar_enabled;
                                            toggled => {
                                                root.lightbar_enabled = self.checked;
                                                root.toggle_lightbar(self.checked);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    ColorChip {
                                        chip_color: #00a2ff;
