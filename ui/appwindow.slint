import { Button, Switch } from "std-widgets.slint";

component ColorChip inherits TouchArea {
    in property <color> chip_color;
    in property <bool> is_selected: false;
    width: 36px;
    height: 36px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: root.chip_color;
        border-width: root.is_selected ? 3px : 1px;
        border-color: root.is_selected ? #ffffff : #333846;
    }
}

component ModeButton inherits TouchArea {
    in property <string> title;
    in property <string> icon;
    in property <bool> is_active: false;
    height: 48px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: root.is_active ? #00ffa3.transparentize(88%) : #1a1d26;
        border-width: root.is_active ? 2px : 1px;
        border-color: root.is_active ? #00ffa3 : #2b3040;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.icon;
                font-size: 15px;
                horizontal-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
                horizontal-alignment: center;
            }
        }
    }
}

component MuxButton inherits TouchArea {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <bool> is_active: false;
    height: 60px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: root.is_active ? #00ffa3.transparentize(88%) : #1a1d26;
        border-width: root.is_active ? 2px : 1px;
        border-color: root.is_active ? #00ffa3 : #2b3040;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.icon;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
                horizontal-alignment: center;
            }
            Text {
                text: root.subtitle;
                font-size: 10px;
                color: root.is_active ? #00ffa3aa : #6b7280;
                horizontal-alignment: center;
            }
        }
    }
}

component NavTab inherits TouchArea {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> is_active: false;
    height: 52px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 9px;
        background: root.is_active ? #141e1a : (parent.has-hover ? #161922 : #00000000);
        border-width: 1px;
        border-color: root.is_active ? #00ffa355 : #00000000;

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: root.is_active ? #00ffa3 : #d1d5db;
            }
            Text {
                text: root.subtitle;
                font-size: 10px;
                color: root.is_active ? #00ffa3aa : #6b7280;
            }
        }
    }
}

component CustomSlider inherits Rectangle {
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);
    callback released(float);

    height: 24px;
    min-width: 180px;
    horizontal-stretch: 1;

    property <float> ratio: Math.clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0.0, 1.0);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        width: 100%;
        border-radius: 3px;
        background: #232733;

        Rectangle {
            x: 0;
            y: 0;
            height: 100%;
            width: root.ratio * parent.width;
            border-radius: 3px;
            background: #00ffa3;
        }
    }

    Rectangle {
        x: root.ratio * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        border-width: 2px;
        border-color: #00ffa3;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        moved => {
            if (self.pressed && root.width > 0px) {
                let r = Math.clamp(self.mouse-x / root.width, 0.0, 1.0);
                let v = Math.round(root.minimum + r * (root.maximum - root.minimum));
                if (v != Math.round(root.value)) {
                    root.changed(v);
                }
            }
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && root.width > 0px) {
                let r = Math.clamp(self.mouse-x / root.width, 0.0, 1.0);
                let v = Math.round(root.minimum + r * (root.maximum - root.minimum));
                root.changed(v);
            }
            if (ev.kind == PointerEventKind.up) {
                root.released(Math.round(root.value));
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AORUS 16X Control";
    icon: @image-url("../assets/icon.png");
    width: 740px;
    height: 560px;
    background: #0d0f14;
    default-font-family: "Segoe UI";

    in-out property <int> active_tab: 0;
    in-out property <string> cpu_temp: "-- °C";
    in-out property <string> cpu_usage: "0%";
    in-out property <string> gpu_temp: "-- °C";
    in-out property <string> gpu_usage: "0%";
    in-out property <string> fan1_rpm: "-- RPM";
    in-out property <string> fan2_rpm: "-- RPM";
    in-out property <float> curve_50: 25;
    in-out property <float> curve_60: 40;
    in-out property <float> curve_70: 55;
    in-out property <float> curve_80: 75;
    in-out property <float> curve_90: 95;
    in-out property <float> kb_brightness: 100;
    in-out property <int> display_hz: 165;
    in-out property <bool> close_to_tray: true;
    in-out property <string> battery_hardware_text: "Donanım Limiti: %100";
    in-out property <string> active_mode: "Normal";
    in-out property <string> active_gpu_mode: "Hybrid";
    in-out property <bool> dgpu_killed: false;
    in-out property <string> dgpu_notice: "ℹ️ dGPU kapatıldığında ekranda 1-2 sn kırpışma olur. Yeniden başlatma gerekmez.";
    in-out property <string> active_kb_color: "Blue";
    in-out property <string> active_bar_color: "Blue";
    in-out property <bool> lightbar_enabled: true;
    in-out property <bool> battery_limit: true;

    callback set_fan_mode(string);
    callback set_curve_point(int, int);
    callback save_curve();
    callback set_gpu_mode(string);
    callback toggle_dgpu_kill();
    callback set_display_hz(int);
    callback toggle_close_to_tray(bool);
    callback set_keyboard_color(string);
    callback set_keyboard_brightness(float);
    callback save_keyboard_brightness(float);
    callback set_lightbar_color(string);
    callback toggle_lightbar(bool);
    callback toggle_battery_limit(bool);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. TOPBAR: Fixed on all tabs
        Rectangle {
            height: 56px;
            background: #0d0f14;

            // Bottom border line
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: #212635;
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "AORUS 16X";
                        font-size: 17px;
                        font-weight: 800;
                        color: #ffffff;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: "Native Hardware & RGB Control";
                        font-size: 11px;
                        color: #6b7280;
                    }
                }

                // 4 Sensor Badges (CPU Fan & GPU Fan labels)
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Rectangle {
                        height: 34px;
                        background: #161922;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #262c3d;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text { text: "CPU"; font-size: 11px; color: #9ca3af; vertical-alignment: center; }
                            Text { text: root.cpu_temp; font-size: 12px; font-weight: 700; color: #00ffa3; vertical-alignment: center; }
                            Text { text: "(" + root.cpu_usage + ")"; font-size: 10px; color: #6ee7b7; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        background: #161922;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #262c3d;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text { text: "GPU"; font-size: 11px; color: #9ca3af; vertical-alignment: center; }
                            Text { text: root.gpu_temp; font-size: 12px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                            Text { text: "(" + root.gpu_usage + ")"; font-size: 10px; color: #7dd3fc; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        background: #161922;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #262c3d;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text { text: "CPU Fan"; font-size: 11px; color: #9ca3af; vertical-alignment: center; }
                            Text { text: root.fan1_rpm; font-size: 12px; font-weight: 700; color: #f59e0b; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        background: #161922;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #262c3d;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text { text: "GPU Fan"; font-size: 11px; color: #9ca3af; vertical-alignment: center; }
                            Text { text: root.fan2_rpm; font-size: 12px; font-weight: 700; color: #ec4899; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // 2. MAIN BODY: Sidebar + Content Area
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            // LEFT SIDEBAR (4 Merged Tabs)
            Rectangle {
                width: 172px;
                background: #0d0f14;

                // Right border line
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: #212635;
                }

                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    NavTab {
                        title: "🌀 Fan & Güç";
                        subtitle: "mod + eğri";
                        is_active: root.active_tab == 0;
                        clicked => { root.active_tab = 0; }
                    }
                    NavTab {
                        title: "🎮 GPU / MUX";
                        subtitle: "hybrid · dgpu · hz";
                        is_active: root.active_tab == 1;
                        clicked => { root.active_tab = 1; }
                    }
                    NavTab {
                        title: "💡 Aydınlatma";
                        subtitle: "klavye + beacon";
                        is_active: root.active_tab == 2;
                        clicked => { root.active_tab = 2; }
                    }
                    NavTab {
                        title: "🔋 Pil";
                        subtitle: "%80 + tray";
                        is_active: root.active_tab == 3;
                        clicked => { root.active_tab = 3; }
                    }
                }
            }

            // RIGHT CONTENT PANE
            Rectangle {
                horizontal-stretch: 1;
                background: #0d0f14;

                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    alignment: start;

                    // TAB 0: FAN & GÜÇ
                    if root.active_tab == 0 : VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    text: "FAN & POWER MODES";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #9ca3af;
                                    letter-spacing: 1px;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ModeButton {
                                        title: "Quiet";
                                        icon: "🍃";
                                        is_active: root.active_mode == "Quiet";
                                        clicked => {
                                            root.active_mode = "Quiet";
                                            root.set_fan_mode("Quiet");
                                        }
                                    }
                                    ModeButton {
                                        title: "Normal";
                                        icon: "⚡";
                                        is_active: root.active_mode == "Normal";
                                        clicked => {
                                            root.active_mode = "Normal";
                                            root.set_fan_mode("Normal");
                                        }
                                    }
                                    ModeButton {
                                        title: "Gaming";
                                        icon: "🎮";
                                        is_active: root.active_mode == "Gaming";
                                        clicked => {
                                            root.active_mode = "Gaming";
                                            root.set_fan_mode("Gaming");
                                        }
                                    }
                                    ModeButton {
                                        title: "Turbo";
                                        icon: "🚀";
                                        is_active: root.active_mode == "Turbo";
                                        clicked => {
                                            root.active_mode = "Turbo";
                                            root.set_fan_mode("Turbo");
                                        }
                                    }
                                    ModeButton {
                                        title: "Custom";
                                        icon: "🛠️";
                                        is_active: root.active_mode == "Custom";
                                        clicked => {
                                            root.active_mode = "Custom";
                                            root.set_fan_mode("Custom");
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "📊  ÖZEL FAN EĞRİSİ (SICAKLIK BASAMAKLARI)";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #f59e0b;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.active_mode == "Custom" ? "AKTİF KULLANILIYOR" : "Custom modunda devreye girer";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: root.active_mode == "Custom" ? #00ffa3 : #6b7280;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "50 °C"; font-size: 12px; font-weight: 700; color: #9ca3af; width: 45px; vertical-alignment: center; }
                                    CustomSlider {
                                        value: root.curve_50;
                                        changed(v) => { root.curve_50 = v; root.set_curve_point(0, Math.round(v)); }
                                        released(v) => { root.save_curve(); }
                                    }
                                    Text { text: "\{Math.round(root.curve_50)}%"; font-size: 12px; font-weight: 700; color: #ffffff; width: 40px; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "60 °C"; font-size: 12px; font-weight: 700; color: #9ca3af; width: 45px; vertical-alignment: center; }
                                    CustomSlider {
                                        value: root.curve_60;
                                        changed(v) => { root.curve_60 = v; root.set_curve_point(1, Math.round(v)); }
                                        released(v) => { root.save_curve(); }
                                    }
                                    Text { text: "\{Math.round(root.curve_60)}%"; font-size: 12px; font-weight: 700; color: #ffffff; width: 40px; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "70 °C"; font-size: 12px; font-weight: 700; color: #9ca3af; width: 45px; vertical-alignment: center; }
                                    CustomSlider {
                                        value: root.curve_70;
                                        changed(v) => { root.curve_70 = v; root.set_curve_point(2, Math.round(v)); }
                                        released(v) => { root.save_curve(); }
                                    }
                                    Text { text: "\{Math.round(root.curve_70)}%"; font-size: 12px; font-weight: 700; color: #ffffff; width: 40px; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "80 °C"; font-size: 12px; font-weight: 700; color: #9ca3af; width: 45px; vertical-alignment: center; }
                                    CustomSlider {
                                        value: root.curve_80;
                                        changed(v) => { root.curve_80 = v; root.set_curve_point(3, Math.round(v)); }
                                        released(v) => { root.save_curve(); }
                                    }
                                    Text { text: "\{Math.round(root.curve_80)}%"; font-size: 12px; font-weight: 700; color: #ffffff; width: 40px; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "90 °C"; font-size: 12px; font-weight: 700; color: #9ca3af; width: 45px; vertical-alignment: center; }
                                    CustomSlider {
                                        value: root.curve_90;
                                        changed(v) => { root.curve_90 = v; root.set_curve_point(4, Math.round(v)); }
                                        released(v) => { root.save_curve(); }
                                    }
                                    Text { text: "\{Math.round(root.curve_90)}%"; font-size: 12px; font-weight: 700; color: #ffffff; width: 40px; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 1: GPU / MUX & EKRAN HIZI
                    if root.active_tab == 1 : VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "🎮  GPU ÇALIŞMA MODU & D-GPU KILL-SWITCH";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #c084fc;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.dgpu_killed ? "dGPU: KAPALI (Maks Pil)" : ("Aktif Donanım: " + root.active_gpu_mode);
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.dgpu_killed ? #ec4899 : (root.active_gpu_mode == "Discrete" ? #00ffa3 : #38bdf8);
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    MuxButton {
                                        title: "Hybrid (Optimus)";
                                        subtitle: "pil tasarrufu";
                                        icon: "🔋";
                                        is_active: !root.dgpu_killed && root.active_gpu_mode == "Hybrid";
                                        clicked => {
                                            root.set_gpu_mode("Hybrid");
                                        }
                                    }

                                    MuxButton {
                                        title: "Discrete (dGPU)";
                                        subtitle: "maksimum fps";
                                        icon: "⚡";
                                        is_active: !root.dgpu_killed && root.active_gpu_mode == "Discrete";
                                        clicked => {
                                            root.set_gpu_mode("Discrete");
                                        }
                                    }

                                    MuxButton {
                                        title: "dGPU Kapalı";
                                        subtitle: "maks pil modu";
                                        icon: "🚫";
                                        is_active: root.dgpu_killed;
                                        clicked => {
                                            root.toggle_dgpu_kill();
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #161922;
                                    border-radius: 8px;
                                    HorizontalLayout {
                                        padding: 8px;
                                        Text {
                                            text: root.dgpu_notice;
                                            font-size: 10px;
                                            color: #f59e0b;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // Ekran Yenileme Hızı Kartı (Win32)
                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

