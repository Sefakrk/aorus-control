                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                        width: 38px;
                                    }
                                }
                            }
                        }
                    }

                    // TAB 3: ARKA IÅžIK
                    if root.active_tab == 3 : VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: #141720;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #212635;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "âœ¨  REAR LIGHTBAR (AORUS BEACON)";
